{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharelynkpublicwebsite",
  // Produced by `opennextjs-cloudflare build` — do not point this at .next.
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // Required by the OpenNext adapter: the Next.js server needs Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Default is "auto-trailing-slash", which 307s /foo.html -> /foo. That
    // broke the Google Search Console verification file: Google requests the
    // exact .html URL and does not follow redirects, so it saw a redirect
    // instead of the token. Next.js does its own routing here, so the asset
    // layer should serve paths verbatim.
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },

  // Runtime environment for the Worker.
  //
  // These MUST live here, not in the dashboard. `wrangler deploy` treats this
  // file as the source of truth for plain-text vars and DELETES any that were
  // set through the dashboard UI but are absent here — which is exactly what
  // silently removed them on the previous deploy and left /api/* returning 503.
  // (Secrets set via `wrangler secret put` survive; plain vars do not.)
  //
  // Neither value is sensitive: both are the public origin of the FastAPI
  // backend. Origin only — no trailing slash and no /api suffix, because the
  // client appends /api itself.
  "vars": {
    "API_INTERNAL_URL": "https://sharelynk-wifi-admin-web-1.onrender.com",
    "API_PROXY_TARGET": "https://sharelynk-wifi-admin-web-1.onrender.com"
  }

  // NEXT_PUBLIC_SITE_URL is deliberately NOT here. NEXT_PUBLIC_* values are
  // inlined into the bundle at compile time, so it has to be a *build*
  // variable in the Cloudflare dashboard; a runtime var would do nothing.
  //   NEXT_PUBLIC_SITE_URL = https://website.sharelynk.app
}

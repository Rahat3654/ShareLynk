# ----------------------------------------------------------------------------
# ShareLynk public website (Next.js) — environment
#
# This site talks to the FastAPI backend (sharelynk/backend). No database or
# secrets live here — the backend owns those (its .env has DATABASE_URL and
# JWT_SECRET).
# ----------------------------------------------------------------------------

# Origin of the FastAPI backend. NO trailing slash and NO /api suffix — the
# client adds /api itself, so this must be the bare origin.
#
# There is no localhost default in production code: an unset value now raises
# instead of silently serving the bundled fallback catalog, which is what
# previously made a broken deployment look healthy.
#
#   local dev  : http://localhost:8000
#   production : https://sharelynk-wifi-admin-web-1.onrender.com
API_INTERNAL_URL=http://localhost:8000

# Same value. Used by the /api/* runtime proxy in src/app/api/[...path]/route.ts
# when API_INTERNAL_URL is unset; keep them identical unless the browser and the
# server need different hosts.
API_PROXY_TARGET=http://localhost:8000

# Public site URL, used for canonical/OG metadata.
#
# Read at BUILD time, so on Cloudflare it must be set as a BUILD variable, not
# only a runtime one. Must include the scheme: `new URL()` throws on a bare
# hostname and fails the build. `.app` is HSTS-preloaded, so https is mandatory.
#
#   production : https://website.sharelynk.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

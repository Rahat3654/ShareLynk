# ----------------------------------------------------------------------------
# ShareLynk public website (Next.js) — environment
#
# This site talks to your EXISTING FastAPI backend (sharelynk/backend), which
# runs on http://localhost:8000. No database or secrets live here — the backend
# owns those (its .env has DATABASE_URL + JWT_SECRET).
#
# The values below are for LOCAL DEVELOPMENT. Production values are set in the
# Netlify dashboard (Site settings -> Environment variables) — see the
# "Production" block at the bottom of this file for what they must be.
# ----------------------------------------------------------------------------

# Browser /api/* requests are proxied here (see next.config.mjs).
API_PROXY_TARGET=http://localhost:8000

# Server-side (SSR/ISR) fetches of the download catalog.
API_INTERNAL_URL=http://localhost:8000

# Public site URL (used for canonical/OG metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Production (set these in Netlify, NOT here)
#
#   NEXT_PUBLIC_SITE_URL=https://sharelynk.app
#   API_PROXY_TARGET=https://api.sharelynk.app
#   API_INTERNAL_URL=https://api.sharelynk.app
#
# Two rules, both of which break the BUILD (not just the page) when violated:
#
#   1. NEXT_PUBLIC_SITE_URL must be a full absolute URL with a scheme and no
#      trailing slash. layout.tsx does `metadataBase: new URL(site.url)`, and
#      new URL() throws on a bare "sharelynk.app", which fails the deploy.
#
#   2. It must be https://. The .app TLD is on the HSTS preload list, so
#      browsers refuse plain http:// for this domain outright — an http value
#      is not "slow to redirect", it is unreachable.
# ----------------------------------------------------------------------------
